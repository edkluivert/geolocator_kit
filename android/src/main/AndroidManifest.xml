<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
      The app declares its own location permissions (ACCESS_FINE_LOCATION
      and/or ACCESS_COARSE_LOCATION, optionally ACCESS_BACKGROUND_LOCATION).
      Apps that use ForegroundNotificationConfig also need FOREGROUND_SERVICE
      and, on Android 14+, FOREGROUND_SERVICE_LOCATION.
    -->
    <application>
        <!-- Foreground location service used with ForegroundNotificationConfig. -->
        <service
            android:name=".GeolocatorKitLocationService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!--
          Invisible proxy that owns the permission dialog and the location
          settings resolution dialog: the DartNative embedding exposes no
          permission-result or activity-result hooks to plugins.
        -->
        <activity
            android:name=".GeolocatorKitProxyActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
    </application>
</manifest>
